# --- Postgres ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=app_pass
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# --- App API ---
APP_PORT=8000
# для контейнера (host=db). Для локального клиента оставь отдельно: postgresql://appuser:app_pass@localhost:5432/appdb
DATABASE_URL_DOCKER=postgresql://appuser:app_pass@db:5432/appdb
# dev-CORS: можно перечислить домены через запятую или оставить *
CORS_ORIGINS=*

# --- pgAdmin (опционально) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_DEFAULT_PORT=5050
# --- External services ---
LINK_ANALYZER_URL=http://link-analyzer:3000/analyze

# --- Link analyzer service (Node.js) ---
PORT=3000
ENABLE_CUA=true
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_BASE_URL=https://api.openai.com/v1

# --- Browserbase ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
USE_BROWSERBASE_FOR_CUA=true

# --- CUA LLM (agent mode) ---
CUA_ENABLED=true
CUA_API_KEY=
CUA_MODEL=
CUA_BASE_URL=
CUA_MAX_STEPS=16
CUA_MAX_TOKENS=4000
