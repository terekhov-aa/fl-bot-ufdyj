# --- Postgres ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=app_pass
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# --- App API ---
APP_PORT=8000
DATABASE_URL_DOCKER=postgresql://appuser:app_pass@db:5432/appdb
CORS_ORIGINS=*

# --- pgAdmin (optional) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_DEFAULT_PORT=5050

# --- External services ---
LINK_ANALYZER_URL=http://link-analyzer:3000/analyze

# --- Link analyzer service (Node.js) ---
PORT=3000
ENABLE_CUA=true
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_BASE_URL=https://api.openai.com/v1
