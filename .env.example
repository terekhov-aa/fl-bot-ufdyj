# --- Postgres ---
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=fl_ingest
POSTGRES_PORT=5432

# --- App API ---
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://user:pass@db:5432/fl_ingest
CORS_ORIGINS=*

# Опциональный URL для других клиентов; основное подключение см. DATABASE_URL
DATABASE_URL_DOCKER=postgresql://appuser:app_pass@db:5432/appdb

# --- pgAdmin (optional) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_DEFAULT_PORT=5050

# --- Link analyzer ---
LINK_ANALYZER_URL=http://link-analyzer:3000/analyze

# --- Link analyzer service (Node.js) ---
PORT=3000
ENABLE_CUA=true
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_BASE_URL=https://api.openai.com/v1

# --- Browserbase ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- CUA LLM (agent mode) ---
CUA_ENABLED=true
CUA_MODEL=
CUA_MAX_STEPS=16
CUA_MAX_TOKENS=4000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
